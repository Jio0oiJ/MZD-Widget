# ===== 白名单式忽略：只备份源码与文档，其余一律不入库 =====
/*
!/.gitignore
!/.gitattributes
!/mzdwidget_build/
!/MZD小组件/
!/tools/

# ---- 源码工程：只保留构建脚本与 src ----
/mzdwidget_build/*
!/mzdwidget_build/app/
!/mzdwidget_build/build.gradle
!/mzdwidget_build/settings.gradle
!/mzdwidget_build/gradle.properties
!/mzdwidget_build/app/*
!/mzdwidget_build/app/src/
!/mzdwidget_build/app/build.gradle

# ---- v1.9.25 手环遥控：源码入库，第三方 AAR 与签名私钥不入库 ----
# 手环快应用源码（JS/配置/协议文档）
!/mzdwidget_build/band_app/
/mzdwidget_build/band_app/*
!/mzdwidget_build/band_app/src/
!/mzdwidget_build/band_app/PROTOCOL.md
!/mzdwidget_build/band_app/package.json
/mzdwidget_build/band_app/node_modules/
/mzdwidget_build/band_app/build/
/mzdwidget_build/band_app/dist/
/mzdwidget_build/band_app/sign/          # 私钥 PEM 绝不入库，从 debug.keystore 现场导出
/mzdwidget_build/.temp_band_app/
# 小米互联闭源 AAR（104KB，可从 mibandnotify 官网下载，不入备份）
/mzdwidget_build/app/libs/

# 构建产物与本机配置
/mzdwidget_build/.gradle/
/mzdwidget_build/local.properties
/mzdwidget_build/app/build/
**/build/
.gradle/
local.properties
*.apk
*.aab
*.ap_
*.jks
*.keystore
*.idsig

# ---- 文档目录：只保留 markdown ----
/MZD小组件/*
!/MZD小组件/*.md

# ---- 工具脚本 ----
/tools/*
!/tools/*.sh

# 通用
*.log
Thumbs.db
.DS_Store
