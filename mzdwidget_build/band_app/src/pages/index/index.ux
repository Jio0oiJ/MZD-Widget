<template>
  <!-- v1.2.1 修复：根容器退回 v1.9.26 已验证可用的单 div（stack 会导致按钮偏左） -->
  <div class="page">
    <text class="title">MZD 控车</text>
    <text class="status">{{ status }}</text>
    <text class="diag">{{ diag }}</text>
    <text class="result">{{ lastResult }}</text>

    <div class="btn unlock" onclick="onUnlock">
      <text class="btn-t">解锁</text>
    </div>
    <div class="btn lock" onclick="onLock">
      <text class="btn-t">上锁</text>
    </div>
    <div class="btn start" ontouchstart="onStartDown" ontouchend="onStartUp" ontouchcancel="onStartCancel">
      <text class="btn-t">一键启动 · 长按3秒</text>
    </div>

    <text class="hint">启动需长按 3 秒</text>

    <!--
      全屏倒计时覆盖层：固定节点 + show 布尔切换。
      用 absolute 盖在最上层，不隐藏 start 按钮节点——touchstart/touchend 的目标
      始终是同一个按钮，提前松手取消能可靠触发（若把按钮 hide，touchend 会丢失）。
    -->
    <div class="cd-layer" show="{{ pressing }}">
      <text class="cd-text">{{ cdText }}</text>
      <text class="cd-hint">松开取消 · 3 秒后启动</text>
    </div>
  </div>
</template>

<script>
/**
 * v1.2.1 / 手机端 v1.9.28 修复三项回归（v1.2.0 实机反馈）：
 * 1) 按钮偏左：去掉 <stack> 根容器，退回 v1.9.26 验证过的单 div.page；
 * 2) 点击只振动不发送：移除 canSend() 里的 !connected 硬拦截——互联诊断
 *    (diagnosis) 在部分时机返回未连接，但 send 实际可用；诊断仅用于状态显示，
 *    真实成败交给 conn.send 的 success/fail 与手机回执；
 * 3) 无全屏倒计时：动画不再依赖诊断结果，按下即显示，3-2-1 用单个文本节点，
 *    避免三个 show 表达式在 Vela 上的兼容问题。
 *
 * 保留：固定 class / 固定文本节点（防 v1.9.25 重影）、NFC 刷卡 1/2 下振动回执、
 * 长按满 3 秒才带 holdMs=3000 下发、手机端完整三步一键启动。
 */
var conn = null
var seq = 0
var ready = false
var pressTimer = null
var pressActive = false
var pressFired = false

function getConn() {
  if (conn) return conn
  try {
    var ic = require('@system.interconnect')
    if (ic && typeof ic.instance === 'function') conn = ic.instance()
  } catch (e) { }
  if (!conn) {
    try {
      var ic2 = require('@system.interconnect')
      var def = ic2 && ic2.default ? ic2.default : ic2
      if (def && typeof def.instance === 'function') conn = def.instance()
    } catch (e2) { }
  }
  return conn
}

/** 连续 n 次短振；失败/异常退化为一次长振 */
function vibrateTimes(n) {
  var count = Number(n)
  if (count !== count || count < 1) count = 1
  if (count > 3) count = 3
  var v = null
  try { v = require('@system.vibrator') } catch (e) { return }
  if (!v || typeof v.vibrate !== 'function') return
  var i = 0
  function next() {
    if (i >= count) return
    i += 1
    try {
      v.vibrate({
        duration: 60,
        success: function () { setTimeout(next, 130) },
        fail: function () { setTimeout(next, 130) }
      })
    } catch (e) { }
  }
  next()
}

function vibrateOnce(ok) {
  try {
    var v = require('@system.vibrator')
    v.vibrate({ duration: ok ? 60 : 200, success: function () {}, fail: function () {} })
  } catch (e) { }
}

export default {
  private: {
    connected: false,
    status: '● 初始化中…',
    diag: '能力检测中…',
    lastResult: '',
    busy: false,
    reqId: '',
    timeoutReq: '',
    pressing: false,
    cdText: ''
  },

  onReady() {
    this.initConn()
  },

  onShow() {
    if (ready) this.diagnose()
  },

  onDestroy() {
    this.clearPress()
    if (!conn) return
    try {
      conn.onmessage = null
      conn.onopen = null
      conn.onclose = null
      conn.onerror = null
    } catch (e) { }
  },

  setResult(text) {
    if (this.lastResult !== text) this.lastResult = text
  },

  setStatus(text) {
    if (this.status !== text) this.status = text
  },

  initConn() {
    var self = this
    var c = getConn()
    if (!c) {
      this.setStatus('● 互联不可用')
      this.diag = '无 @system.interconnect'
      return
    }
    var caps = []
    if (typeof c.send === 'function') caps.push('send')
    if (typeof c.diagnosis === 'function') caps.push('diag')
    this.diag = '能力: ' + (caps.length ? caps.join('/') : '无')
    if (typeof c.send !== 'function') {
      this.setStatus('● 互联实例异常')
      return
    }

    try {
      c.onopen = function () {
        self.setStatus('● 已连接手机')
        self.diagnose()
      }
      c.onclose = function () {
        self.setStatus('● 未连接手机')
        self.connected = false
      }
      c.onerror = function (e) {
        self.connected = false
        self.setStatus('● 连接异常')
        self.diag = '错误: ' + ((e && e.data) || '未知')
      }
      c.onmessage = function (event) {
        var msg = null
        try {
          var text = event
          if (event && typeof event === 'object' && typeof event.data === 'string') text = event.data
          if (typeof text === 'string') msg = JSON.parse(text)
        } catch (e) { return }
        self.onResult(msg)
      }
    } catch (e) {
      this.setStatus('● 注册回调失败')
      this.diag = '注册异常: ' + e.message
      return
    }
    ready = true
    this.diagnose()
  },

  diagnose() {
    var self = this
    if (!conn || typeof conn.diagnosis !== 'function') return
    try {
      conn.diagnosis({
        success: function (data) {
          var ok = data && Number(data.status) === 0
          self.connected = !!ok
          self.setStatus(ok ? '● 已连接手机' : '● 未连接手机')
        },
        fail: function () {
          self.connected = false
          self.setStatus('● 未连接手机')
        }
      })
    } catch (e) { }
  },

  onResult(msg) {
    if (!msg || msg.type !== 'mzd_result') return
    // 手机 NFC 刷卡切换的纯振动反馈：reqId 固定 nfc_vibrate，不参与按钮指令的 reqId 配对
    if (msg.action === 'feedback') {
      if (msg.vibrate) vibrateTimes(msg.vibrate)
      return
    }
    // 回执 reqId 必须与当前指令一致，防迟到旧回执错配到新指令
    if (msg.reqId !== this.reqId) return
    this.busy = false
    this.timeoutReq = ''
    var ok = !!msg.ok
    var m = msg.msg || ''
    if (m.length > 18) m = m.substring(0, 18)
    this.setResult(ok ? m : ('失败: ' + m))
    if (ok && msg.vibrate) vibrateTimes(msg.vibrate)
    else vibrateOnce(ok)
  },

  canSend() {
    if (this.busy) {
      this.setResult('上一条指令处理中')
      return false
    }
    if (!conn || !ready) {
      this.setResult('互联未就绪')
      vibrateOnce(false)
      return false
    }
    // v1.2.1：不再用 diagnosis 结果拦截。诊断在 Vela 上偶发误报"未连接"，
    // 但 send 实际可用（v1.9.26 实机已验证）；真实成败由 send 回调 + 手机回执判定。
    return true
  },

  sendCommand(action) {
    if (!this.canSend()) return
    seq += 1
    var reqId = 'm' + Date.now() + '_' + seq
    this.busy = true
    this.reqId = reqId
    this.timeoutReq = reqId
    var label = action === 'unlock' ? '解锁' : (action === 'lock' ? '上锁' : '一键启动')
    this.setResult(label + '发送中…')
    var self = this
    var timeoutMs = action === 'start' ? 15000 : 8000
    setTimeout(function () {
      if (self.busy && self.timeoutReq === reqId) {
        self.busy = false
        self.timeoutReq = ''
        self.setResult('超时，未收到回执')
        vibrateOnce(false)
      }
    }, timeoutMs)

    var data = { type: 'mzd_cmd', action: action, reqId: reqId }
    if (action === 'start') data.holdMs = 3000
    conn.send({
      data: data,
      success: function () { },
      fail: function () {
        if (self.reqId !== reqId) return
        self.busy = false
        self.timeoutReq = ''
        self.setResult('发送失败')
        vibrateOnce(false)
      }
    })
  },

  onUnlock() { this.sendCommand('unlock') },
  onLock() { this.sendCommand('lock') },

  clearPress() {
    if (pressTimer !== null) {
      clearTimeout(pressTimer)
      pressTimer = null
    }
    pressActive = false
    this.pressing = false
    this.cdText = ''
  },

  countdown(left) {
    if (!pressActive || pressFired) return
    if (left <= 0) {
      pressFired = true
      this.clearPress()
      this.sendCommand('start')
      return
    }
    this.cdText = '' + left
    var self = this
    pressTimer = setTimeout(function () { self.countdown(left - 1) }, 1000)
  },

  onStartDown() {
    if (pressActive) return
    if (!this.canSend()) return
    pressActive = true
    pressFired = false
    this.pressing = true
    this.countdown(3)
  },

  onStartUp() {
    if (!pressActive || pressFired) return
    this.clearPress()
    this.setResult('长按需 3 秒')
    vibrateOnce(false)
  },

  onStartCancel() {
    if (!pressActive || pressFired) return
    this.clearPress()
    this.setResult('已取消')
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  padding: 8px;
  background-color: #000000;
}
.title {
  font-size: 26px;
  color: #ffffff;
  font-weight: bold;
  text-align: center;
  margin-top: 4px;
}
.status {
  font-size: 19px;
  color: #ffffff;
  text-align: center;
  margin-top: 8px;
}
.diag {
  font-size: 13px;
  color: #9e9e9e;
  text-align: center;
  margin-top: 4px;
  height: 22px;
}
.result {
  font-size: 17px;
  color: #ffd54f;
  text-align: center;
  margin-top: 4px;
  height: 30px;
}
.btn {
  width: 280px;
  height: 76px;
  border-radius: 18px;
  margin-top: 10px;
  justify-content: center;
  align-items: center;
}
.unlock { background-color: #2e7d32; }
.lock { background-color: #c62828; }
.start { background-color: #455a64; }
.btn-t {
  font-size: 26px;
  color: #ffffff;
  font-weight: bold;
  text-align: center;
}
.hint {
  font-size: 13px;
  color: #9e9e9e;
  text-align: center;
  margin-top: 10px;
}
/* 全屏倒计时：absolute 覆盖（Vela 常用定位方式，不改变 minPlatformVersion） */
.cd-layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: #000000;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.cd-text {
  font-size: 180px;
  color: #ffffff;
  font-weight: bold;
  text-align: center;
}
.cd-hint {
  font-size: 18px;
  color: #9e9e9e;
  text-align: center;
  margin-top: 16px;
}
</style>
