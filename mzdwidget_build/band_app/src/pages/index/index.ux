<template>
  <!-- v1.2.9：放弃所有 flex 撑高/均分与 show 互斥满屏容器（实机已证伪：Vela 上
       flex:1 不撑高、隐藏容器仍占布局空间，导致按钮堆上半屏、数字被挤出屏外）。
       本版所有顶层元素 position:absolute + 固定像素坐标，彼此独立不共享文档流；
       倒计时层绝对定位盖在最上，show=false 不渲染不拦截点击（v1.2.3 实机已验证）。 -->
  <div class="page">
    <div class="header">
      <text class="title">MZD控车</text>
      <div class="dot dot-red" show="{{ dotRed }}"></div>
      <div class="dot dot-green" show="{{ dotGreen }}"></div>
      <div class="dot dot-yellow" show="{{ dotYellow }}"></div>
    </div>

    <div class="btn unlock" onclick="onUnlock"><text class="btn-t">解锁</text></div>
    <div class="btn lock" onclick="onLock"><text class="btn-t">上锁</text></div>
    <div class="btn start" ontouchstart="onStartDown" ontouchend="onStartUp" ontouchcancel="onStartCancel">
      <text class="btn-t">一键启动</text>
    </div>

    <!-- 全屏倒计时：绝对定位覆盖层，盒内居中数字；show=false 时不渲染、不拦截按钮点击 -->
    <div class="cd-layer" show="{{ pressing }}" ontouchend="onStartUp" ontouchcancel="onStartCancel">
      <text class="cd-text" show="{{ cdNum3 }}">3</text>
      <text class="cd-text" show="{{ cdNum2 }}">2</text>
      <text class="cd-text" show="{{ cdNum1 }}">1</text>
    </div>
  </div>
</template>

<script>
/**
 * v1.2.9 / 手机端 v1.9.36 极简界面：
 * - 顶部「MZD控车」+ 右侧圆点：红=未连接、绿=已连接、黄闪两下=指令已发送；
 * - 去掉状态/能力/结果文字与底部提示，三个按钮放大；
 * - 保留 v1.2.1 修复：canSend 不做 connected 硬拦截、松手取消可达。
 *
 * 圆点、倒计时数字都用固定节点 + show 布尔切换（避免 Vela 动态 class 重绘重影）。
 * v1.2.9 关键修复（依据 v1.2.8 两张实机截图）：Vela 上 show=false 的容器仍占布局空间——
 * 隐藏的倒计时盒把按钮挤到上半屏、隐藏的按钮组把数字顶到屏幕底部只剩白弧。
 * 本版所有顶层元素改 position:absolute + 固定像素坐标，彼此独立不共享文档流：
 *   - 按钮绝对定位在 top 70/184/298，宽292高100，不依赖 flex 撑高或 show 占位；
 *   - 倒计时层绝对定位覆盖整页，show=false 不渲染不拦截点击（v1.2.3 实机已验证）。
 * 黄闪用 setTimeout 做 亮-灭-亮-灭 两轮，结束自动回到连接状态色。
 */
var conn = null
var seq = 0
var ready = false
var pressTimer = null
var pressActive = false
var pressFired = false
var flashTimer = null
var flashSeq = 0

function getConn() {
  if (conn) return conn
  try {
    var ic = require('@system.interconnect')
    if (ic && typeof ic.instance === 'function') conn = ic.instance()
  } catch (e) { }
  if (!conn) {
    try {
      var ic2 = require('@system.interconnect')
      var def = ic2 && ic2.default ? ic2.default : ic2
      if (def && typeof def.instance === 'function') conn = def.instance()
    } catch (e2) { }
  }
  return conn
}

/** 连续 n 次短振；失败/异常退化为一次长振 */
function vibrateTimes(n) {
  var count = Number(n)
  if (count !== count || count < 1) count = 1
  if (count > 3) count = 3
  var v = null
  try { v = require('@system.vibrator') } catch (e) { return }
  if (!v || typeof v.vibrate !== 'function') return
  var i = 0
  function next() {
    if (i >= count) return
    i += 1
    try {
      v.vibrate({
        duration: 60,
        success: function () { setTimeout(next, 130) },
        fail: function () { setTimeout(next, 130) }
      })
    } catch (e) { }
  }
  next()
}

function vibrateOnce(ok) {
  try {
    var v = require('@system.vibrator')
    v.vibrate({ duration: ok ? 60 : 200, success: function () {}, fail: function () {} })
  } catch (e) { }
}

export default {
  private: {
    connected: false,
    lastResult: '',
    busy: false,
    reqId: '',
    timeoutReq: '',
    pressing: false,
    mainShow: true,
    cdNum1: false,
    cdNum2: false,
    cdNum3: false,
    dotRed: true,
    dotGreen: false,
    dotYellow: false,
    flashing: false,
    flashOn: false
  },

  onReady() {
    this.syncDot()
    this.initConn()
  },

  onShow() {
    if (ready) this.diagnose()
  },

  onDestroy() {
    this.clearPress()
    if (flashTimer !== null) {
      clearTimeout(flashTimer)
      flashTimer = null
    }
    flashSeq += 1
    if (!conn) return
    try {
      conn.onmessage = null
      conn.onopen = null
      conn.onclose = null
      conn.onerror = null
    } catch (e) { }
  },

  setResult(text) {
    if (this.lastResult !== text) this.lastResult = text
  },

  /** 按连接状态 + 闪烁标志刷新三个圆点，只置一个为 true */
  syncDot() {
    if (this.flashing) {
      this.dotRed = false
      this.dotGreen = false
      this.dotYellow = !!this.flashOn
    } else {
      this.dotRed = !this.connected
      this.dotGreen = !!this.connected
      this.dotYellow = false
    }
  },

  /** 黄色闪两下：亮-灭-亮-灭，结束自动恢复连接色 */
  flashDot() {
    var self = this
    flashSeq += 1
    var mySeq = flashSeq
    if (flashTimer !== null) {
      clearTimeout(flashTimer)
      flashTimer = null
    }
    var steps = [true, false, true, false]
    var i = 0
    function next() {
      if (mySeq !== flashSeq) return
      if (i >= steps.length) {
        self.flashing = false
        self.flashOn = false
        self.syncDot()
        return
      }
      self.flashOn = steps[i]
      self.syncDot()
      i += 1
      flashTimer = setTimeout(next, 180)
    }
    next()
  },

  initConn() {
    var self = this
    var c = getConn()
    if (!c) {
      this.syncDot()
      return
    }
    if (typeof c.send !== 'function') {
      this.syncDot()
      return
    }

    try {
      c.onopen = function () {
        self.connected = true
        self.syncDot()
        self.diagnose()
      }
      c.onclose = function () {
        self.connected = false
        self.syncDot()
      }
      c.onerror = function (e) {
        self.connected = false
        self.syncDot()
      }
      c.onmessage = function (event) {
        var msg = null
        try {
          var text = event
          if (event && typeof event === 'object' && typeof event.data === 'string') text = event.data
          if (typeof text === 'string') msg = JSON.parse(text)
        } catch (e) { return }
        self.onResult(msg)
      }
    } catch (e) {
      this.syncDot()
      return
    }
    ready = true
    this.diagnose()
  },

  diagnose() {
    var self = this
    if (!conn || typeof conn.diagnosis !== 'function') return
    try {
      conn.diagnosis({
        success: function (data) {
          var ok = data && Number(data.status) === 0
          self.connected = !!ok
          self.syncDot()
        },
        fail: function () {
          self.connected = false
          self.syncDot()
        }
      })
    } catch (e) { }
  },

  onResult(msg) {
    if (!msg || msg.type !== 'mzd_result') return
    // 手机 NFC 刷卡切换的纯振动反馈：reqId 固定 nfc_vibrate，不参与按钮指令配对
    if (msg.action === 'feedback') {
      if (msg.vibrate) vibrateTimes(msg.vibrate)
      return
    }
    if (msg.reqId !== this.reqId) return
    this.busy = false
    this.timeoutReq = ''
    var ok = !!msg.ok
    if (ok && msg.vibrate) vibrateTimes(msg.vibrate)
    else vibrateOnce(ok)
  },

  canSend() {
    if (this.busy) {
      this.setResult('上一条指令处理中')
      return false
    }
    if (!conn || !ready) {
      this.setResult('互联未就绪')
      vibrateOnce(false)
      return false
    }
    // 不因 diagnosis 的偶发误报拦截发送，成败交给 send 回调 + 手机回执
    return true
  },

  sendCommand(action) {
    if (!this.canSend()) return
    seq += 1
    var reqId = 'm' + Date.now() + '_' + seq
    this.busy = true
    this.reqId = reqId
    this.timeoutReq = reqId
    var self = this
    var timeoutMs = action === 'start' ? 15000 : 8000
    setTimeout(function () {
      if (self.busy && self.timeoutReq === reqId) {
        self.busy = false
        self.timeoutReq = ''
        vibrateOnce(false)
      }
    }, timeoutMs)

    var data = { type: 'mzd_cmd', action: action, reqId: reqId }
    if (action === 'start') data.holdMs = 3000
    conn.send({
      data: data,
      success: function () {
        // 指令已发出：黄点闪两下（与连接色互斥，结束自动恢复）
        self.flashing = true
        self.flashDot()
      },
      fail: function () {
        if (self.reqId !== reqId) return
        self.busy = false
        self.timeoutReq = ''
        vibrateOnce(false)
      }
    })
  },

  onUnlock() { this.sendCommand('unlock') },
  onLock() { this.sendCommand('lock') },

  /** 倒计时数字用三个固定节点 show 切换（同圆点机制，避免 Vela 动态文本整页切换时黑屏） */
  syncCd(n) {
    this.cdNum3 = n === 3
    this.cdNum2 = n === 2
    this.cdNum1 = n === 1
  },

  clearPress() {
    if (pressTimer !== null) {
      clearTimeout(pressTimer)
      pressTimer = null
    }
    pressActive = false
    this.pressing = false
    this.mainShow = true
    this.syncCd(0)
  },

  countdown(left) {
    if (!pressActive || pressFired) return
    if (left <= 0) {
      pressFired = true
      this.clearPress()
      this.sendCommand('start')
      return
    }
    this.syncCd(left)
    var self = this
    pressTimer = setTimeout(function () { self.countdown(left - 1) }, 1000)
  },

  onStartDown() {
    if (pressActive) return
    if (!this.canSend()) return
    pressActive = true
    pressFired = false
    this.pressing = true
    this.mainShow = false
    this.countdown(3)
  },

  onStartUp() {
    if (!pressActive || pressFired) return
    this.clearPress()
    vibrateOnce(false)
  },

  onStartCancel() {
    if (!pressActive || pressFired) return
    this.clearPress()
  }
}
</script>

<style>
/* 手环9 Pro：336(宽)×480(高)。v1.2.9 全部改 position:absolute + 固定像素坐标，
   每个顶层元素彼此独立、不共享文档流：不依赖 flex 撑高/均分，也不受 show 隐藏节点占位影响。 */
.page {
  position: relative;
  width: 100%;
  height: 100%;
  background-color: #000000;
}
/* 标题栏：绝对定位在顶部，左右 22px。横向 flex(row) 排列在 Vela 已验证正常 */
.header {
  position: absolute;
  left: 22px;
  top: 0px;
  width: 292px;
  height: 56px;
  flex-direction: row;
  align-items: center;
}
.title {
  flex: 1;
  font-size: 30px;
  color: #ffffff;
  font-weight: bold;
}
.dot {
  width: 22px;
  height: 22px;
  border-radius: 11px;
  margin-left: 8px;
}
.dot-red { background-color: #e53935; }
.dot-green { background-color: #43a047; }
.dot-yellow { background-color: #fdd835; }
/* 三个按钮：绝对定位，固定 top/left/height，彼此完全独立。
   宽 292 = 336 - 22*2；高 100（用户已确认大小 OK）；间距 14px。
   top: 解锁 70 / 上锁 184 / 一键启动 298，底部到 398，屏高 480 留 82px 留白 */
.btn {
  position: absolute;
  left: 22px;
  width: 292px;
  height: 100px;
  border-radius: 24px;
  justify-content: center;
  align-items: center;
}
.unlock { top: 70px; background-color: #2e7d32; }
.lock   { top: 184px; background-color: #c62828; }
.start  { top: 298px; background-color: #455a64; }
.btn-t {
  font-size: 36px;
  color: #ffffff;
  font-weight: bold;
  text-align: center;
}
/* 全屏倒计时：绝对定位覆盖整个页面，盖在按钮之上。show=false 不渲染、不拦截点击
   （v1.2.3 实机已验证：此结构下能看到数字、按钮仍可点击）。盒内居中数字 */
.cd-layer {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 100%;
  height: 100%;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000000;
}
/* 三个固定数字节点用 show 切换（同圆点机制）；show=false 不占位，唯一可见节点由盒内居中 */
.cd-text {
  font-size: 200px;
  color: #ffffff;
  font-weight: bold;
  text-align: center;
}
</style>
