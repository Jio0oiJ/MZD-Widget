<template>
  <!-- v1.2.4：按手环9 Pro 真实 336×480 重排；主界面/倒计时用 show 互斥整页切换，不依赖 absolute -->
  <div class="page" ontouchend="onStartUp" ontouchcancel="onStartCancel">
    <div class="main" show="{{ mainShow }}">
      <div class="header">
        <text class="title">MZD控车</text>
        <!-- 三个固定圆点节点用 show 切换，只显示一个；不用动态 class（防重影） -->
        <div class="dot dot-red" show="{{ dotRed }}"></div>
        <div class="dot dot-green" show="{{ dotGreen }}"></div>
        <div class="dot dot-yellow" show="{{ dotYellow }}"></div>
      </div>

      <!-- 按钮组占满 header 以下的全部高度，三个按钮沿垂直方向均匀铺开 -->
      <div class="btn-group">
        <div class="btn unlock" onclick="onUnlock">
          <text class="btn-t">解锁</text>
        </div>
        <div class="btn lock" onclick="onLock">
          <text class="btn-t">上锁</text>
        </div>
        <!-- touchend/cancel 同时绑在按钮和根容器，确保松手取消在整页切换后仍可达 -->
        <div class="btn start" ontouchstart="onStartDown" ontouchend="onStartUp" ontouchcancel="onStartCancel">
          <text class="btn-t">一键启动 · 长按3秒</text>
        </div>
      </div>
    </div>

    <!-- 全屏倒计时：与主界面 show 互斥，整页黑底 + 居中大数字；同时接收松手取消 -->
    <div class="cd-layer" show="{{ pressing }}" ontouchend="onStartUp" ontouchcancel="onStartCancel">
      <text class="cd-text">{{ cdText }}</text>
    </div>
  </div>
</template>

<script>
/**
 * v1.2.3 / 手机端 v1.9.30 极简界面：
 * - 顶部「MZD控车」+ 右侧圆点：红=未连接、绿=已连接、黄闪两下=指令已发送；
 * - 去掉状态/能力/结果文字与底部提示，三个按钮放大；
 * - 保留 v1.2.1 修复：单 div 根、canSend 不做 connected 硬拦截、松手取消可达。
 *
 * 圆点用三个固定节点 + show 布尔切换（避免 Vela 动态 class 重绘重影）。
 * 黄闪用 setTimeout 做 亮-灭-亮-灭 两轮，结束自动回到连接状态色。
 */
var conn = null
var seq = 0
var ready = false
var pressTimer = null
var pressActive = false
var pressFired = false
var flashTimer = null
var flashSeq = 0

function getConn() {
  if (conn) return conn
  try {
    var ic = require('@system.interconnect')
    if (ic && typeof ic.instance === 'function') conn = ic.instance()
  } catch (e) { }
  if (!conn) {
    try {
      var ic2 = require('@system.interconnect')
      var def = ic2 && ic2.default ? ic2.default : ic2
      if (def && typeof def.instance === 'function') conn = def.instance()
    } catch (e2) { }
  }
  return conn
}

/** 连续 n 次短振；失败/异常退化为一次长振 */
function vibrateTimes(n) {
  var count = Number(n)
  if (count !== count || count < 1) count = 1
  if (count > 3) count = 3
  var v = null
  try { v = require('@system.vibrator') } catch (e) { return }
  if (!v || typeof v.vibrate !== 'function') return
  var i = 0
  function next() {
    if (i >= count) return
    i += 1
    try {
      v.vibrate({
        duration: 60,
        success: function () { setTimeout(next, 130) },
        fail: function () { setTimeout(next, 130) }
      })
    } catch (e) { }
  }
  next()
}

function vibrateOnce(ok) {
  try {
    var v = require('@system.vibrator')
    v.vibrate({ duration: ok ? 60 : 200, success: function () {}, fail: function () {} })
  } catch (e) { }
}

export default {
  private: {
    connected: false,
    lastResult: '',
    busy: false,
    reqId: '',
    timeoutReq: '',
    pressing: false,
    mainShow: true,
    cdText: '',
    dotRed: true,
    dotGreen: false,
    dotYellow: false,
    flashing: false,
    flashOn: false
  },

  onReady() {
    this.syncDot()
    this.initConn()
  },

  onShow() {
    if (ready) this.diagnose()
  },

  onDestroy() {
    this.clearPress()
    if (flashTimer !== null) {
      clearTimeout(flashTimer)
      flashTimer = null
    }
    flashSeq += 1
    if (!conn) return
    try {
      conn.onmessage = null
      conn.onopen = null
      conn.onclose = null
      conn.onerror = null
    } catch (e) { }
  },

  setResult(text) {
    if (this.lastResult !== text) this.lastResult = text
  },

  /** 按连接状态 + 闪烁标志刷新三个圆点，只置一个为 true */
  syncDot() {
    if (this.flashing) {
      this.dotRed = false
      this.dotGreen = false
      this.dotYellow = !!this.flashOn
    } else {
      this.dotRed = !this.connected
      this.dotGreen = !!this.connected
      this.dotYellow = false
    }
  },

  /** 黄色闪两下：亮-灭-亮-灭，结束自动恢复连接色 */
  flashDot() {
    var self = this
    flashSeq += 1
    var mySeq = flashSeq
    if (flashTimer !== null) {
      clearTimeout(flashTimer)
      flashTimer = null
    }
    var steps = [true, false, true, false]
    var i = 0
    function next() {
      if (mySeq !== flashSeq) return
      if (i >= steps.length) {
        self.flashing = false
        self.flashOn = false
        self.syncDot()
        return
      }
      self.flashOn = steps[i]
      self.syncDot()
      i += 1
      flashTimer = setTimeout(next, 180)
    }
    next()
  },

  initConn() {
    var self = this
    var c = getConn()
    if (!c) {
      this.syncDot()
      return
    }
    if (typeof c.send !== 'function') {
      this.syncDot()
      return
    }

    try {
      c.onopen = function () {
        self.connected = true
        self.syncDot()
        self.diagnose()
      }
      c.onclose = function () {
        self.connected = false
        self.syncDot()
      }
      c.onerror = function (e) {
        self.connected = false
        self.syncDot()
      }
      c.onmessage = function (event) {
        var msg = null
        try {
          var text = event
          if (event && typeof event === 'object' && typeof event.data === 'string') text = event.data
          if (typeof text === 'string') msg = JSON.parse(text)
        } catch (e) { return }
        self.onResult(msg)
      }
    } catch (e) {
      this.syncDot()
      return
    }
    ready = true
    this.diagnose()
  },

  diagnose() {
    var self = this
    if (!conn || typeof conn.diagnosis !== 'function') return
    try {
      conn.diagnosis({
        success: function (data) {
          var ok = data && Number(data.status) === 0
          self.connected = !!ok
          self.syncDot()
        },
        fail: function () {
          self.connected = false
          self.syncDot()
        }
      })
    } catch (e) { }
  },

  onResult(msg) {
    if (!msg || msg.type !== 'mzd_result') return
    // 手机 NFC 刷卡切换的纯振动反馈：reqId 固定 nfc_vibrate，不参与按钮指令配对
    if (msg.action === 'feedback') {
      if (msg.vibrate) vibrateTimes(msg.vibrate)
      return
    }
    if (msg.reqId !== this.reqId) return
    this.busy = false
    this.timeoutReq = ''
    var ok = !!msg.ok
    if (ok && msg.vibrate) vibrateTimes(msg.vibrate)
    else vibrateOnce(ok)
  },

  canSend() {
    if (this.busy) {
      this.setResult('上一条指令处理中')
      return false
    }
    if (!conn || !ready) {
      this.setResult('互联未就绪')
      vibrateOnce(false)
      return false
    }
    // 不因 diagnosis 的偶发误报拦截发送，成败交给 send 回调 + 手机回执
    return true
  },

  sendCommand(action) {
    if (!this.canSend()) return
    seq += 1
    var reqId = 'm' + Date.now() + '_' + seq
    this.busy = true
    this.reqId = reqId
    this.timeoutReq = reqId
    var self = this
    var timeoutMs = action === 'start' ? 15000 : 8000
    setTimeout(function () {
      if (self.busy && self.timeoutReq === reqId) {
        self.busy = false
        self.timeoutReq = ''
        vibrateOnce(false)
      }
    }, timeoutMs)

    var data = { type: 'mzd_cmd', action: action, reqId: reqId }
    if (action === 'start') data.holdMs = 3000
    conn.send({
      data: data,
      success: function () {
        // 指令已发出：黄点闪两下（与连接色互斥，结束自动恢复）
        self.flashing = true
        self.flashDot()
      },
      fail: function () {
        if (self.reqId !== reqId) return
        self.busy = false
        self.timeoutReq = ''
        vibrateOnce(false)
      }
    })
  },

  onUnlock() { this.sendCommand('unlock') },
  onLock() { this.sendCommand('lock') },

  clearPress() {
    if (pressTimer !== null) {
      clearTimeout(pressTimer)
      pressTimer = null
    }
    pressActive = false
    this.pressing = false
    this.mainShow = true
    this.cdText = ''
  },

  countdown(left) {
    if (!pressActive || pressFired) return
    if (left <= 0) {
      pressFired = true
      this.clearPress()
      this.sendCommand('start')
      return
    }
    this.cdText = '' + left
    var self = this
    pressTimer = setTimeout(function () { self.countdown(left - 1) }, 1000)
  },

  onStartDown() {
    if (pressActive) return
    if (!this.canSend()) return
    pressActive = true
    pressFired = false
    this.pressing = true
    this.mainShow = false
    this.countdown(3)
  },

  onStartUp() {
    if (!pressActive || pressFired) return
    this.clearPress()
    vibrateOnce(false)
  },

  onStartCancel() {
    if (!pressActive || pressFired) return
    this.clearPress()
  }
}
</script>

<style>
/* 手环9 Pro 真实分辨率 336(宽)×480(高)，device-width 下按此排布 */
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  background-color: #000000;
}
/* 主界面：占满整页，与主界面/倒计时 show 互斥 */
.main {
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  padding-left: 22px;
  padding-right: 22px;
}
.header {
  width: 100%;
  height: 56px;
  flex-shrink: 0;
  flex-direction: row;
  align-items: center;
}
.title {
  flex: 1;
  font-size: 32px;
  color: #ffffff;
  font-weight: bold;
}
.dot {
  width: 24px;
  height: 24px;
  border-radius: 12px;
  margin-left: 10px;
}
.dot-red { background-color: #e53935; }
.dot-green { background-color: #43a047; }
.dot-yellow { background-color: #fdd835; }
/* 按钮组：占满 header 以下全部高度，三个按钮均匀铺开（含上下留白） */
.btn-group {
  width: 100%;
  flex: 1;
  flex-direction: column;
  justify-content: space-around;
  align-items: center;
}
/* 按钮高度 100px（较上版 84px 加大约 20%），三按钮共 300px 铺满剩余高度 */
.btn {
  width: 100%;
  height: 100px;
  flex-shrink: 0;
  border-radius: 24px;
  justify-content: center;
  align-items: center;
}
.unlock { background-color: #2e7d32; }
.lock { background-color: #c62828; }
.start { background-color: #455a64; }
.btn-t {
  font-size: 36px;
  color: #ffffff;
  font-weight: bold;
  text-align: center;
}
/* 全屏倒计时：与 .main show 互斥，整页黑底 + 居中大数字，不依赖 absolute */
.cd-layer {
  width: 100%;
  height: 100%;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000000;
}
.cd-text {
  font-size: 220px;
  color: #ffffff;
  font-weight: bold;
  text-align: center;
}
</style>
