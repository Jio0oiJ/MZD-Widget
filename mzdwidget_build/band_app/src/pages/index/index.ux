<template>
  <!-- v1.3.1：布局完全回到 v1.2.3（用户确认按键大小/位置没问题），几何一个像素未动。
       倒计时期间把 header/按钮组设为 show=false（仍占位，按钮位置不变），
       避免 Vela 下黑底边缘漏出按钮色块。
       倒计时改成三个「绝对定位 + 固定大尺寸 + 盒内居中」的 layer，
       每层里放一个固定数字，用 show 互斥切换；不用 {{ 动态文本 }}（Vela 上曾整层渲染不出导致黑屏）。 -->
  <div class="page">
    <div class="header" show="{{ uiVisible }}">
      <text class="title">MZD控车</text>
      <!-- 三个固定圆点节点用 show 切换，只显示一个；不用动态 class（防重影） -->
      <div class="dot dot-red" show="{{ dotRed }}"></div>
      <div class="dot dot-green" show="{{ dotGreen }}"></div>
      <div class="dot dot-yellow" show="{{ dotYellow }}"></div>
    </div>

    <!-- 按钮组占满 header 以下的全部高度，三个按钮沿垂直方向均匀铺开 -->
    <div class="btn-group" show="{{ uiVisible }}">
      <div class="btn unlock" onclick="onUnlock">
        <text class="btn-t">解锁</text>
      </div>
      <div class="btn lock" onclick="onLock">
        <text class="btn-t">上锁</text>
      </div>
      <div class="btn start" ontouchstart="onStartDown" ontouchend="onStartUp" ontouchcancel="onStartCancel">
        <text class="btn-t">一键启动</text>
      </div>
    </div>

    <!-- 全屏倒计时：一个数字一层，层间 show 互斥。
         实机截图显示 100% 的 absolute 层没有铺满，故用固定大尺寸 + 负偏移，
         中心点 (170,240) 仍对准屏幕正中 (168,240)。 -->
    <div class="cd-layer" show="{{ cdNum3 }}" ontouchend="onStartUp" ontouchcancel="onStartCancel">
      <text class="cd-text">3</text>
    </div>
    <div class="cd-layer" show="{{ cdNum2 }}" ontouchend="onStartUp" ontouchcancel="onStartCancel">
      <text class="cd-text">2</text>
    </div>
    <div class="cd-layer" show="{{ cdNum1 }}" ontouchend="onStartUp" ontouchcancel="onStartCancel">
      <text class="cd-text">1</text>
    </div>
  </div>
</template>

<script>
/**
 * v1.3.0 / 手机端 v1.9.37：
 * - 布局整体回到 v1.2.3（百分比宽度按钮 + 按钮组纵向铺满，用户确认大小位置 OK）；
 * - 倒计时改为三个固定数字节点 + show 切换，容器 absolute 满屏 + 盒内居中。
 *
 * 圆点用三个固定节点 + show 布尔切换（避免 Vela 动态 class 重绘重影）。
 * 黄闪用 setTimeout 做 亮-灭-亮-灭 两轮，结束自动回到连接状态色。
 */
var conn = null
var seq = 0
var ready = false
var pressTimer = null
var pressActive = false
var pressFired = false
var flashTimer = null
var flashSeq = 0
var diagTimer = null       // v1.3.2：周期性互联诊断定时器
var diagFailStreak = 0     // 连续诊断失败次数，用于红点慢闪提示"通道不通"
var blinkTimer = null      // v1.3.2：红点慢闪定时器

function getConn() {
  if (conn) return conn
  try {
    var ic = require('@system.interconnect')
    if (ic && typeof ic.instance === 'function') conn = ic.instance()
  } catch (e) { }
  if (!conn) {
    try {
      var ic2 = require('@system.interconnect')
      var def = ic2 && ic2.default ? ic2.default : ic2
      if (def && typeof def.instance === 'function') conn = def.instance()
    } catch (e2) { }
  }
  return conn
}

/** 连续 n 次短振；失败/异常退化为一次长振 */
function vibrateTimes(n) {
  var count = Number(n)
  if (count !== count || count < 1) count = 1
  if (count > 3) count = 3
  var v = null
  try { v = require('@system.vibrator') } catch (e) { return }
  if (!v || typeof v.vibrate !== 'function') return
  var i = 0
  function next() {
    if (i >= count) return
    i += 1
    try {
      v.vibrate({
        duration: 60,
        success: function () { setTimeout(next, 130) },
        fail: function () { setTimeout(next, 130) }
      })
    } catch (e) { }
  }
  next()
}

function vibrateOnce(ok) {
  try {
    var v = require('@system.vibrator')
    v.vibrate({ duration: ok ? 60 : 200, success: function () {}, fail: function () {} })
  } catch (e) { }
}

export default {
  private: {
    connected: false,
    lastResult: '',
    busy: false,
    reqId: '',
    timeoutReq: '',
    uiVisible: true,
    cdNum3: false,
    cdNum2: false,
    cdNum1: false,
    dotRed: true,
    dotGreen: false,
    dotYellow: false,
    flashing: false,
    flashOn: false,
    redBlink: false   // v1.3.2：红点慢闪=通道不通（连续诊断失败）
  },

  onReady() {
    this.syncDot()
    this.initConn()
    // v1.3.2：每 2 秒重试一次互联诊断。手机侧（MIUI 关联启动/服务）恢复后自动变绿，
    // 无需退出重进快应用；连续失败时红点慢闪，区分"通道不通"与"确认未连接"。
    var self = this
    if (diagTimer !== null) clearInterval(diagTimer)
    diagTimer = setInterval(function () { self.diagnose() }, 2000)
  },

  onShow() {
    if (ready) this.diagnose()
  },

  onDestroy() {
    this.clearPress()
    if (flashTimer !== null) {
      clearTimeout(flashTimer)
      flashTimer = null
    }
    if (diagTimer !== null) {
      clearInterval(diagTimer)
      diagTimer = null
    }
    if (blinkTimer !== null) {
      clearInterval(blinkTimer)
      blinkTimer = null
    }
    flashSeq += 1
    if (!conn) return
    try {
      conn.onmessage = null
      conn.onopen = null
      conn.onclose = null
      conn.onerror = null
    } catch (e) { }
  },

  setResult(text) {
    if (this.lastResult !== text) this.lastResult = text
  },

  /** 按连接状态 + 闪烁标志刷新三个圆点，只置一个为 true
   *  v1.3.2：红点慢闪(redBlink)=连续诊断失败、通道不通；红点常亮=未连接但通道正常 */
  syncDot() {
    if (this.flashing) {
      this.dotRed = false
      this.dotGreen = false
      this.dotYellow = !!this.flashOn
    } else if (this.connected) {
      this.dotRed = false
      this.dotGreen = true
      this.dotYellow = false
    } else {
      // redBlink=true 时红点由 blinkTimer 独立控制亮灭；false 时常亮
      this.dotRed = !this.redBlink
      this.dotGreen = false
      this.dotYellow = false
    }
  },

  /** 黄色闪两下：亮-灭-亮-灭，结束自动恢复连接色 */
  flashDot() {
    var self = this
    flashSeq += 1
    var mySeq = flashSeq
    if (flashTimer !== null) {
      clearTimeout(flashTimer)
      flashTimer = null
    }
    var steps = [true, false, true, false]
    var i = 0
    function next() {
      if (mySeq !== flashSeq) return
      if (i >= steps.length) {
        self.flashing = false
        self.flashOn = false
        self.syncDot()
        return
      }
      self.flashOn = steps[i]
      self.syncDot()
      i += 1
      flashTimer = setTimeout(next, 180)
    }
    next()
  },

  initConn() {
    var self = this
    var c = getConn()
    if (!c) {
      this.syncDot()
      return
    }
    if (typeof c.send !== 'function') {
      this.syncDot()
      return
    }

    try {
      c.onopen = function () {
        self.applyDiag(true)
      }
      c.onclose = function () {
        self.applyDiag(false)
      }
      c.onerror = function (e) {
        self.applyDiag(false)
      }
      c.onmessage = function (event) {
        var msg = null
        try {
          var text = event
          if (event && typeof event === 'object' && typeof event.data === 'string') text = event.data
          if (typeof text === 'string') msg = JSON.parse(text)
        } catch (e) { return }
        self.onResult(msg)
      }
    } catch (e) {
      this.syncDot()
      return
    }
    ready = true
    this.diagnose()
  },

  /** v1.3.2：诊断后按结果调红点——连续失败≥2次则慢闪（通道不通提示），成功则恢复常态 */
  applyDiag(ok) {
    this.connected = !!ok
    if (ok) {
      diagFailStreak = 0
      if (this.redBlink) {
        this.redBlink = false
        if (blinkTimer !== null) { clearInterval(blinkTimer); blinkTimer = null }
      }
      this.syncDot()
      return
    }
    diagFailStreak += 1
    if (diagFailStreak >= 2 && !this.redBlink) {
      this.redBlink = true
      var self = this
      if (blinkTimer !== null) clearInterval(blinkTimer)
      blinkTimer = setInterval(function () {
        if (!self.redBlink || self.flashing || self.connected) return
        self.dotRed = !self.dotRed
      }, 500)
    }
    this.syncDot()
  },

  diagnose() {
    var self = this
    if (!conn || typeof conn.diagnosis !== 'function') return
    try {
      conn.diagnosis({
        success: function (data) {
          var ok = data && Number(data.status) === 0
          self.applyDiag(ok)
        },
        fail: function () {
          self.applyDiag(false)
        }
      })
    } catch (e) {
      self.applyDiag(false)
    }
  },

  onResult(msg) {
    if (!msg || msg.type !== 'mzd_result') return
    // 手机 NFC 刷卡切换的纯振动反馈：reqId 固定 nfc_vibrate，不参与按钮指令配对
    if (msg.action === 'feedback') {
      if (msg.vibrate) vibrateTimes(msg.vibrate)
      return
    }
    if (msg.reqId !== this.reqId) return
    this.busy = false
    this.timeoutReq = ''
    var ok = !!msg.ok
    if (ok && msg.vibrate) vibrateTimes(msg.vibrate)
    else vibrateOnce(ok)
  },

  canSend() {
    if (this.busy) {
      this.setResult('上一条指令处理中')
      return false
    }
    if (!conn || !ready) {
      this.setResult('互联未就绪')
      vibrateOnce(false)
      return false
    }
    // 不因 diagnosis 的偶发误报拦截发送，成败交给 send 回调 + 手机回执
    return true
  },

  sendCommand(action) {
    if (!this.canSend()) return
    seq += 1
    var reqId = 'm' + Date.now() + '_' + seq
    this.busy = true
    this.reqId = reqId
    this.timeoutReq = reqId
    var self = this
    var timeoutMs = action === 'start' ? 15000 : 8000
    setTimeout(function () {
      if (self.busy && self.timeoutReq === reqId) {
        self.busy = false
        self.timeoutReq = ''
        vibrateOnce(false)
      }
    }, timeoutMs)

    var data = { type: 'mzd_cmd', action: action, reqId: reqId }
    if (action === 'start') data.holdMs = 3000
    conn.send({
      data: data,
      success: function () {
        // 指令已发出：黄点闪两下（与连接色互斥，结束自动恢复）
        self.flashing = true
        self.flashDot()
      },
      fail: function () {
        if (self.reqId !== reqId) return
        self.busy = false
        self.timeoutReq = ''
        vibrateOnce(false)
      }
    })
  },

  onUnlock() { this.sendCommand('unlock') },
  onLock() { this.sendCommand('lock') },

  /** 只切数字节点，不碰 pressing（松手取消靠 pressing=false 直接关层） */
  setCdNum(n) {
    this.cdNum3 = n === 3
    this.cdNum2 = n === 2
    this.cdNum1 = n === 1
  },

  clearPress() {
    if (pressTimer !== null) {
      clearTimeout(pressTimer)
      pressTimer = null
    }
    pressActive = false
    this.uiVisible = true
    this.cdNum3 = false
    this.cdNum2 = false
    this.cdNum1 = false
  },

  countdown(left) {
    if (!pressActive || pressFired) return
    if (left <= 0) {
      pressFired = true
      this.clearPress()
      this.sendCommand('start')
      return
    }
    this.setCdNum(left)
    var self = this
    pressTimer = setTimeout(function () { self.countdown(left - 1) }, 1000)
  },

  onStartDown() {
    if (pressActive) return
    if (!this.canSend()) return
    pressActive = true
    pressFired = false
    this.uiVisible = false
    this.countdown(3)
  },

  onStartUp() {
    if (!pressActive || pressFired) return
    this.clearPress()
    vibrateOnce(false)
  },

  onStartCancel() {
    if (!pressActive || pressFired) return
    this.clearPress()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  padding-left: 24px;
  padding-right: 24px;
  background-color: #000000;
}
.header {
  width: 100%;
  height: 44px;
  flex-shrink: 0;
  flex-direction: row;
  align-items: center;
}
.title {
  flex: 1;
  font-size: 30px;
  color: #ffffff;
  font-weight: bold;
}
.dot {
  width: 26px;
  height: 26px;
  border-radius: 13px;
  margin-left: 8px;
}
.dot-red { background-color: #e53935; }
.dot-green { background-color: #43a047; }
.dot-yellow { background-color: #fdd835; }
/* 按钮组：占满 header 以下全部高度，三个按钮均匀铺开（含上下留白） */
.btn-group {
  width: 100%;
  flex: 1;
  flex-direction: column;
  justify-content: space-around;
  align-items: center;
}
/* 宽度用百分比：device-width 解析宽度小于 480 时也不会溢出屏幕/圆角 */
.btn {
  width: 100%;
  height: 84px;
  flex-shrink: 0;
  border-radius: 22px;
  justify-content: center;
  align-items: center;
}
.unlock { background-color: #2e7d32; }
.lock { background-color: #c62828; }
.start { background-color: #455a64; }
.btn-t {
  font-size: 32px;
  color: #ffffff;
  font-weight: bold;
  text-align: center;
}
/* 全屏倒计时：absolute 满屏黑底 + 盒内居中（两个机制均实机验证可用）；
   绝对定位脱离文档流，show=false 时不占位、不挤压按钮 */
.cd-layer {
  position: absolute;
  left: -40px;
  top: -40px;
  width: 420px;
  height: 560px;
  background-color: #000000;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.cd-text {
  font-size: 200px;
  color: #ffffff;
  font-weight: bold;
  text-align: center;
}
</style>
