<?xml version="1.0" encoding="utf-8"?>
<!-- 经典白色半透明磨砂玻璃卡片背景（约 30% 不透明度） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#4DFFFFFF"
        android:centerColor="#47FFFFFF"
        android:endColor="#40FFFFFF"
        android:type="linear" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="#5AFFFFFF" />
</shape>
