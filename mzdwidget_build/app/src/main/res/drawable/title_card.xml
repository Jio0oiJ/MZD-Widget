<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面标题卡片：白色磨砂，保持较好可读性（与桌面组件的 20% 透明区分） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#F7FFFFFF"
        android:centerColor="#F0FFFFFF"
        android:endColor="#E6FFFFFF"
        android:type="linear" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="#BFFFFFFF" />
</shape>
