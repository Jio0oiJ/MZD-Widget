<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_frosted">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- 左侧：上方 品牌+车况（上移），下方左下角 一键启动+解锁 -->
        <LinearLayout
            android:id="@+id/status_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.05"
            android:orientation="vertical"
            android:paddingEnd="6dp"
            android:clickable="true"
            android:focusable="true">

            <!-- 字样上移：品牌 + 车况 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="top">

                <TextView
                    android:id="@+id/tv_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MAZDA 昂克赛拉"
                    android:textColor="#8A1A2B"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:shadowColor="#FFFFFFFF" android:shadowRadius="4" />

                <!-- 车况一行：未启动 车门已锁(黑色) / 已启动 车门未锁(红色)，由代码动态设置 -->
                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未启动  车门已锁"
                    android:textColor="#212121"
                    android:textSize="16.8sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:shadowColor="#FFFFFFFF" android:shadowRadius="5" />
            </LinearLayout>

            <!-- 左下角：一键启动+解锁（红色启动图标 + 红色文字，与右侧按钮等高） -->
            <FrameLayout
                android:id="@+id/btn_smart_start"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="2dp"
                android:background="@drawable/btn_glass">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_start" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="一键启动+解锁"
                        android:textColor="#C41230"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginStart="6dp"
                        android:shadowColor="#FFFFFFFF" android:shadowRadius="3" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- 右侧：2x2 按钮（40% 磨砂底板）：熄火 / 寻车 / 解锁 / 上锁 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <FrameLayout android:id="@+id/btn_stall"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:layout_margin="3dp"
                    android:background="@drawable/btn_glass">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="match_parent" android:orientation="vertical"
                        android:gravity="center">
                        <ImageView android:layout_width="30dp" android:layout_height="30dp"
                            android:src="@drawable/ic_stall" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="熄火" android:textColor="#5A6268" android:textSize="10sp"
                            android:textStyle="bold"
                            android:shadowColor="#FFFFFFFF" android:shadowRadius="3" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout android:id="@+id/btn_find"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:layout_margin="3dp"
                    android:background="@drawable/btn_glass">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="match_parent" android:orientation="vertical"
                        android:gravity="center">
                        <ImageView android:layout_width="30dp" android:layout_height="30dp"
                            android:src="@drawable/ic_find" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="寻车" android:textColor="#E8871A" android:textSize="10sp"
                            android:textStyle="bold"
                            android:shadowColor="#FFFFFFFF" android:shadowRadius="3" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <FrameLayout android:id="@+id/btn_unlock"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:layout_margin="3dp"
                    android:background="@drawable/btn_glass">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="match_parent" android:orientation="vertical"
                        android:gravity="center">
                        <ImageView android:layout_width="30dp" android:layout_height="30dp"
                            android:src="@drawable/ic_unlock" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="解锁" android:textColor="#1B8A5A" android:textSize="10sp"
                            android:textStyle="bold"
                            android:shadowColor="#FFFFFFFF" android:shadowRadius="3" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout android:id="@+id/btn_lock"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:layout_margin="3dp"
                    android:background="@drawable/btn_glass">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="match_parent" android:orientation="vertical"
                        android:gravity="center">
                        <ImageView android:layout_width="30dp" android:layout_height="30dp"
                            android:src="@drawable/ic_lock" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="上锁" android:textColor="#1565C0" android:textSize="10sp"
                            android:textStyle="bold"
                            android:shadowColor="#FFFFFFFF" android:shadowRadius="3" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
