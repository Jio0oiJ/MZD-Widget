<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="扫描到的设备（按信号由强到弱，点击即选中）"
        android:textSize="13sp"
        android:textColor="#333333" />

    <ListView
        android:id="@+id/lv_pick_devices"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="6dp"
        android:divider="#DDDDDD"
        android:dividerHeight="1dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="没扫到目标设备？手动输入（MAC 必填，名称可选）"
        android:textSize="13sp"
        android:textColor="#333333" />

    <EditText
        android:id="@+id/et_pick_mac"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="MAC 地址，如 AA:BB:CC:DD:EE:FF"
        android:inputType="textCapCharacters|textNoSuggestions"
        android:singleLine="true"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/et_pick_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="设备名称（可选，用于名称兜底过滤）"
        android:inputType="textNoSuggestions"
        android:singleLine="true"
        android:textSize="14sp" />
</LinearLayout>
